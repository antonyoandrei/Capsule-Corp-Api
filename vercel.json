  {
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "functions": {
      "api/server.js": {
        "maxDuration": 10,
        "includeFiles": "db.json"
      }
    },
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/api/server"
      }
    ]
  }
